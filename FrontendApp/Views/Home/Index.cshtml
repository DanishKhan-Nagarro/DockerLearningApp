@model IEnumerable<FrontendApp.Services.WeatherForecast>

<div class="text-center">
    <h1 class="display-4">Docker Learning Application</h1>
    <p>Frontend MVC application calling Backend API.</p>
    <p>ASP.NET Core MVC application containerized using Docker.</p>
</div>

<table class="table table-bordered mt-4">
    <thead>
        <tr>
            <th>Date</th>
            <th>Temperature (C)</th>
            <th>Summary</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model ?? Enumerable.Empty<FrontendApp.Services.WeatherForecast>())
        {
            <tr>
                <td>@item.Date</td>
                <td>@item.TemperatureC</td>
                <td>@item.Summary</td>
            </tr>
        }
    </tbody>
</table>